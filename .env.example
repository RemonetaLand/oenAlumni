# Postgres connection string (local dev uses docker-compose.yml)
DATABASE_URL=postgres://oen:oen_local_dev@127.0.0.1:5434/oenalumni
# Random 32+ char secret used to sign admin session cookies and hash tokens (openssl rand -base64 32)
AUTH_SECRET=
# Fixed admin login for /admin-panel (temporary; replace with real accounts later). Both empty = disabled.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public origin of the site, used in email links
SITE_URL=http://localhost:3000
# Resend API key. If empty, emails are printed to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Oxford Entrepreneurs Alumni Network <info@oenalumni.com>
# Where partner enquiries are emailed (Hadley)
PARTNER_NOTIFY_EMAIL=
# Cloudflare Turnstile. If empty, the bot check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
